# =============================================================================
# فاحص - Environment Variables (تحديث: 2026-10-01)
# =============================================================================
# ⚠️ تحذير أمني: لا تشارك هذه القيم أو ترفعها إلى Git
# انسخ هذا الملف إلى .env.local وأضف القيم الحقيقية

# =============================================================================
# Application Configuration
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secrets - استخدم: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-64-characters
RATE_LIMIT_PEPPER=replace-with-another-random-secret-at-least-32-characters
APP_SECRET=replace-with-app-secret-at-least-64-characters

# =============================================================================
# Admin Configuration
# =============================================================================
# أرقام المدراء بدون +966 (مفصولة بفواصل)
ADMIN_PHONES=5XXXXXXXXX
# معرّفات Clerk للمدراء الذين يسجّلون بالبريد فقط (بلا رقم جوال)، مفصولة بفواصل.
# لمعرفة المعرّف من البريد:
#   curl -s -H "Authorization: Bearer $CLERK_SECRET_KEY" \
#     "https://api.clerk.com/v1/users?email_address[]=USER@example.com" | grep -o '"id":"user_[^"]*"' | head -1
ADMIN_CLERK_IDS=
# مالك الموقع (Owner): صلاحيات كاملة بدون بوابة رمز الدخول، ويفتح كل أقسام الموقع
# (لوحة الإدارة + لوحة العميل + لوحة الفاحص). يقبل أرقام جوال أو معرّفات Clerk، مفصولة بفواصل.
ADMIN_OWNER_PHONES=
ADMIN_OWNER_CLERK_IDS=
# كلمة مرور إدارية قوية (8+ حروف، أرقام، رموز)
ADMIN_ACCESS_CODE=ChangeThisStrongPassword123!

# =============================================================================
# OTP Configuration
# =============================================================================
# للتطوير: mock | للإنتاج: twilio
OTP_PROVIDER=mock
OTP_EXPIRY_MINUTES=3
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PEPPER=replace-with-random-32-byte-hex

# Twilio (مطلوب للإنتاج فقط)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+966XXXXXXXXX

# =============================================================================
# Clerk Authentication
# =============================================================================
# ⚠️ CLERK_SECRET_KEY يجب أن يبقى سرياً (لا تستخدم NEXT_PUBLIC_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/complete
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/complete

# =============================================================================
# Supabase Database
# =============================================================================
# ⚠️ SUPABASE_SECRET_KEY هو service role key (لا تستخدم NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# =============================================================================
# Moyasar — بوابة الدفع
# =============================================================================
# المفتاح العام (publishable) يظهر في متصفح كل زائر بطبيعته، لذا لا بأس بوضعه هنا.
# قيمته الحقيقية للتطوير موجودة في .env.local
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_3Hb7YGNVb4mRarM6p6KuyE6JqN7myGDK4VfAjv2G

# ⚠️ MOYASAR_SECRET_KEY سرّي تمامًا: يقرأ كل المدفوعات ويستطيع تنفيذ استرجاع.
# لا يُكتب هنا أبدًا (هذا الملف مُتتبَّع في مستودع عام) — ضعه في .env.local وفي Vercel فقط.
MOYASAR_SECRET_KEY=sk_test_replace_with_your_own_secret_key

# الرمز السرّي للـWebhook — يجب أن يطابق حرفيًا القيمة في لوحة Moyasar
# (Settings ← Webhooks ← Secret Token). أنشئه بـ:
#   node -e "console.log('mwh_'+require('crypto').randomBytes(32).toString('hex'))"
MOYASAR_WEBHOOK_SECRET=mwh_replace_with_a_random_64_char_hex

# =============================================================================
# Security Headers (للإنتاج فقط)
# =============================================================================
# NODE_ENV=production
# ENABLE_SECURITY_HEADERS=true
