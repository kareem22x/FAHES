# local env files
.env
.env*.local

# The template must stay committable.
#
# The repo-root `.gitignore` ignores `.env*` and then negates `!.env.example` —
# but that negation has no `**/`, so it only matches the repo root. Without the
# line below, `mobile/.env.example` is silently ignored by the parent pattern
# and never reaches a clone: a new developer gets no env template for the app,
# with nothing in any check to say so. A deeper `.gitignore` takes precedence
# over a shallower one for the same path, which is what makes this work.
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
